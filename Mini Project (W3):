class Product:

    def __init__(self, name, price, quantity):
        self.name = name
        self.price = price
        self.quantity = quantity

    def get_total(self):
        return self.price * self.quantity


class Bill:

    def __init__(self, tax_rate=18):
        self.products = []
        self.tax_rate = tax_rate

    def add_product(self, product):
        self.products.append(product)

    def calculate_total(self):
        total = 0

        for product in self.products:
            total += product.get_total()

        return total

    def calculate_tax(self):
        return self.calculate_total() * self.tax_rate / 100

    def display_bill(self):

        print("\n" + "=" * 65)
        print("                 CUSTOMER BILL")
        print("=" * 65)

        print(f"{'Product':<20}{'Price':>12}{'Quantity':>12}{'Total':>15}")
        print("-" * 65)

        for product in self.products:
            print(
                f"{product.name:<20}"
                f"{product.price:>12.2f}"
                f"{product.quantity:>12}"
                f"{product.get_total():>15.2f}"
            )

        subtotal = self.calculate_total()
        tax = self.calculate_tax()
        final_total = subtotal + tax

        print("-" * 65)
        print(f"{'Subtotal:':>48}{subtotal:>15.2f}")
        print(f"{'Tax (' + str(self.tax_rate) + '%):':>48}{tax:>15.2f}")
        print("=" * 65)
        print(f"{'Final Amount:':>48}{final_total:>15.2f}")
        print("=" * 65)


# Creating Bill Object
bill = Bill(18)

# Taking Product Details
while True:

    name = input("\nEnter product name (or 'done' to finish): ")

    if name.lower() == "done":
        break

    try:
        price = float(input("Enter product price: "))
        quantity = int(input("Enter quantity: "))

        if price <= 0 or quantity <= 0:
            print("Price and quantity must be positive!")
            continue

        product = Product(name, price, quantity)

        bill.add_product(product)

        print("Product added successfully!")

    except ValueError:
        print("Please enter valid price and quantity!")

# Display Final Bill
if bill.products:
    bill.display_bill()
else:
    print("No products added!")
